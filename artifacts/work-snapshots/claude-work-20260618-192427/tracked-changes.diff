+      tension: 220,
+      useNativeDriver: true,
+    }).start();
+  };
+
+  return (
+    <Animated.View style={{ transform: [{ scale }] }}>
+      <Pressable
+        disabled={disabled}
+        hitSlop={hitSlop}
+        onPress={onPress}
+        onPressIn={() => animateTo(pressScale)}
+        onPressOut={() => animateTo(1)}
+        style={style}
+      >
+        {children}
+      </Pressable>
+    </Animated.View>
+  );
