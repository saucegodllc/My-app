# Public Expo config
EXPO_PUBLIC_API_URL=https://connectsphere-api.onrender.com
EXPO_PUBLIC_ENVIRONMENT=production
EXPO_PUBLIC_CONNECTSPHERE_RELEASE=connectsphere-mobile-1.0.0
EXPO_PUBLIC_BUILD_NUMBER=1

# Auth
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# Crash reporting and source map upload
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Consent-aware analytics
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat mobile subscriptions
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_me
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_replace_me

# Push notifications — required for match alerts
# Get your project ID from: https://expo.dev/accounts/[username]/projects/[slug]
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id-here
EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION=true
# Set true while smoke-testing device registration and /api/notify/test.
EXPO_PUBLIC_PUSH_DEBUG=false

# GIPHY — replace the public test key before App Store submission
# Get a production key at: https://developers.giphy.com/
EXPO_PUBLIC_GIPHY_API_KEY=dc6zaTOxFJmzC

# Launch feature flags
EXPO_PUBLIC_FEATURE_DOUBLE_DATE=true
EXPO_PUBLIC_FEATURE_PREMIUM=true
EXPO_PUBLIC_FEATURE_PUSH=true
EXPO_PUBLIC_FEATURE_EVENTS_LIVE_PROVIDERS=true
EXPO_PUBLIC_FEATURE_AI_BIO=true
EXPO_PUBLIC_FEATURE_RESUME_UPLOAD=true
EXPO_PUBLIC_CONNECTSPHERE_LOCAL_DB_FALLBACK=false
EXPO_PUBLIC_ENABLE_DEMO_SEEDS=false
