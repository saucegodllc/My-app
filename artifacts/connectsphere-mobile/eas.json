{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "EXPO_PUBLIC_ENABLE_PUSH_REGISTRATION": "true",
        "EXPO_PUBLIC_FEATURE_PUSH": "true",
        "EXPO_PUBLIC_PUSH_DEBUG": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "preview",
        "EXPO_PUBLIC_API_URL": "https://connectsphere-api.onrender.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://connectsphere-api.onrender.com",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuY29ubmVjdHNwaGVyZS5hcHAk"
      }
    },
    "e2e": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "preview",
        "EXPO_PUBLIC_API_URL": "https://connectsphere-api.onrender.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://connectsphere-api.onrender.com",
        "EXPO_PUBLIC_ENABLE_DEMO_SEEDS": "true",
        "EXPO_PUBLIC_E2E_SMOKE": "true"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_API_URL": "https://connectsphere-api.onrender.com",
        "EXPO_PUBLIC_API_BASE_URL": "https://connectsphere-api.onrender.com",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuY29ubmVjdHNwaGVyZS5hcHAk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "saucegodllc@gmail.com",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
