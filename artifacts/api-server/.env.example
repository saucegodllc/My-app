# Copy this file to .env.local and paste your real Clerk Secret Key.
# It starts with sk_test_ for development or sk_live_ for production.
CLERK_SECRET_KEY=sk_test_paste_your_real_clerk_secret_key_here

# Live events
# Ticketmaster is the main public feed for Miami + Broward events.
TICKETMASTER_API_KEY=paste_ticketmaster_discovery_api_key_here

# Optional tuning
EVENTS_CACHE_TTL_MS=60000
EVENTS_LOOKAHEAD_DAYS=90
EVENTS_RADIUS_MILES=60
