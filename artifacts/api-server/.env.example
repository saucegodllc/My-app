# Copy this file to .env.local and paste your real keys.
CLERK_SECRET_KEY=sk_test_paste_your_real_clerk_secret_key_here

# ── Ticketmaster Discovery API ────────────────────────────────────────────────
# Sign up free at https://developer.ticketmaster.com → My Apps → Consumer Key
# The server fetches all Miami + Broward events on startup and refreshes every 7 days.
# Trigger an immediate re-fetch any time: POST /api/events/refresh
TICKETMASTER_API_KEY=paste_ticketmaster_discovery_api_key_here

# ── Events engine tuning (all optional) ──────────────────────────────────────
# How often to refresh events from Ticketmaster (default: 7 days = 604800000ms)
EVENTS_CACHE_TTL_MS=604800000
# How many days ahead to fetch (default: 7 — the full coming week)
EVENTS_LOOKAHEAD_DAYS=7
# Search radius around Miami in miles (default: 60 — covers Miami-Dade + Broward)
EVENTS_RADIUS_MILES=60
# Max Ticketmaster pages per refresh × 100 events/page (default: 5 = up to 500 events)
TICKETMASTER_MAX_PAGES=5
# Set to "true" to serve fallback mock events whenever Ticketmaster is unavailable.
# Recommended: true in both local dev AND production — real TM events layer on top when the key works.
# With this on, the Events tab is NEVER empty: users always see Miami content.
EVENTS_USE_MOCKS=true
# How long to wait before retrying Ticketmaster after a failed/empty refresh (default: 15 min)
EVENTS_FAIL_RETRY_MS=900000

# Production operations
NODE_ENV=development
CONNECTSPHERE_RELEASE=connectsphere-api-local
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
CONNECTSPHERE_ADMIN_TOKEN=replace-with-long-random-token
REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-webhook-secret
CONNECTSPHERE_PREMIUM_ENTITLEMENT_ID=plus

# Launch feature flags
CONNECTSPHERE_FEATURE_DOUBLE_DATE=true
CONNECTSPHERE_FEATURE_PREMIUM=true
CONNECTSPHERE_FEATURE_PUSH=true
CONNECTSPHERE_FEATURE_EVENTS_LIVE_PROVIDERS=false
CONNECTSPHERE_FEATURE_AI_BIO=true
CONNECTSPHERE_FEATURE_RESUME_UPLOAD=true
CONNECTSPHERE_LOCAL_DB_FALLBACK=false
